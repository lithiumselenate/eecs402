{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译当前 C++ 文件 (C++98)",
            "type": "cppbuild",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++98",
                "-Wall",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
